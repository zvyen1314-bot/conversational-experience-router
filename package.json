{
  "name": "conversational-experience-router",
  "version": "1.0.0-alpha.1",
  "private": true,
  "description": "A safety-first experience layer for conversational AI, with a Claude MCP reference adapter.",
  "type": "module",
  "bin": {
    "conversational-experience-router": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/runtime.test.mjs test/create-module.test.mjs test/import-module.test.mjs test/public-topics.test.mjs test/registry-tools.test.mjs test/alpha-infrastructure.test.mjs",
    "validate-module": "npm run build --silent && node scripts/validate-module.mjs",
    "create-module": "node scripts/create-module.mjs",
    "import-module": "npm run build --silent && node scripts/import-module.mjs",
    "create-publisher-key": "node scripts/create-publisher-key.mjs",
    "sign-module": "npm run build --silent && node scripts/sign-module.mjs",
    "verify-module": "npm run build --silent && node scripts/verify-module.mjs",
    "build-registry-index": "npm run build --silent && node scripts/build-registry-index.mjs",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0"
  }
}
